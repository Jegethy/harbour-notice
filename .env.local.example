# Copy to .env.local and fill in from your Supabase project settings.
# Project Settings -> API

# Safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. One-time code for pairing a floor tablet at /setup.
#
# Required in production: without it the board endpoints refuse every request
# rather than serving your staff list and photos to the open internet.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# This also signs the device cookie, so changing it revokes every paired
# tablet and they must be set up again. That is the revocation mechanism.
BOARD_SETUP_TOKEN=

# SERVER ONLY. Signs the short-lived "unlocked for editing" cookie that the
# 4-digit PIN mints. Generate the same way as above. If unset, BOARD_SETUP_TOKEN
# is used instead — fine for a single-site install.
BOARD_UNLOCK_SECRET=

# SERVER ONLY. Bypasses Row Level Security.
#
# This is what lets a tablet show the board and record a handover swap without
# holding any database credentials of its own. It must never be imported into a
# client component, never be prefixed NEXT_PUBLIC_, and never be committed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Hostnames allowed to reach dev-only assets when running `next dev` behind a
# tunnel. Comma separated. No effect on `next start`.
ALLOWED_DEV_ORIGINS=notice.harbourcare.co.uk
